# Required — OpenAI API key for Codex App Server / Responses fallback
OPENAI_API_KEY=sk-...

# Required — shared secret between agent/ and party/ to prevent trace-channel impersonation
# Generate: openssl rand -hex 32
AGENT_SECRET=

# Required — shared secret for projector trace/reveal route
# Generate: openssl rand -hex 32
PROJECTOR_SECRET=

# Required — shared secret for /admin host controls
# Generate: openssl rand -hex 32
ADMIN_SECRET=

# Required — which PartyKit room the agent joins
# Local dev:  127.0.0.1:1999
# Deployed:   wheres-codex.<your-handle>.partykit.dev
PARTY_HOST=127.0.0.1:1999

# Required for QR generation and deployed web config
# Example: https://wheres-codex.vercel.app
PUBLIC_WEB_URL=http://127.0.0.1:5173

# Exposed to Vite web build; should match PARTY_HOST
VITE_PARTY_HOST=127.0.0.1:1999

# Required — room code the agent participates in
ROOM=SGN-LOCAL

# Demo/game tuning
MIN_PLAYERS=4
DEMO_MODE=1

# Optional — override the model used by Codex App Server
# Prefer current available Codex model from App Server model/list
# CODEX_MODEL=gpt-5.3-codex

# Optional — only if replacing local cadence heuristic with model gate
# CADENCE_MODEL=gpt-5.4-mini
